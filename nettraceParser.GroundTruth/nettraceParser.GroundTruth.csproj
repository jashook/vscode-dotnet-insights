<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <WarningLevel>3</WarningLevel>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      This is the one project in the repo deliberately allowed to depend on
      TraceEvent - nettraceParser/ itself intentionally does not (see its own
      CLAUDE.md note). The point of this project is to be an independent
      second implementation, built on the same library PerfView's GC Stats
      view and dotnet-trace's own analyzers use, so it can catch bugs in
      nettraceParser's hand-rolled decoder that nettraceParser's own tests
      never would (any bug shared between "what nettraceParser computes" and
      "what nettraceParser's tests expect" is invisible to nettraceParser's
      own test suite, no matter how many of those tests exist).
    -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.5" />
  </ItemGroup>

</Project>
